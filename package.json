{
  "name": "robxie-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/env-run.cjs --npm-script dev:without-env",
    "build": "node scripts/env-run.cjs --npm-script build:without-env",
    "start": "node scripts/env-run.cjs --npm-script start:without-env",
    "typecheck": "tsc --noEmit",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "e2e": "playwright test",
    "gen:images": "node scripts/env-run.cjs --npm-script gen:images:without-env",
    "gen:loops": "node scripts/env-run.cjs --npm-script gen:loops:without-env",
    "dev:without-env": "next dev",
    "build:without-env": "npm run validate && next build",
    "start:without-env": "next start",
    "gen:images:without-env": "node scripts/generate/images.mjs",
    "gen:loops:without-env": "node scripts/generate/loops.mjs",
    "env:check": "node scripts/env-run.cjs --check"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
