{
  "name": "robxie-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate": "node --experimental-strip-types scripts/validate-content.ts",
    "e2e": "playwright test",
    "gen:images": "node --env-file=.env scripts/generate/images.mjs",
    "gen:loops": "node --env-file=.env scripts/generate/loops.mjs"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
